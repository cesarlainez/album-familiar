# ══════════════════════════════════════════════════════════════
# Copia este archivo a  .env  y rellena los valores de tu proyecto.
# El .env NO se sube a git (ver .gitignore).
# Supabase → Project Settings → Data API / API Keys.
# ══════════════════════════════════════════════════════════════

# URL del proyecto (igual que en js/config.js)
SUPABASE_URL=https://TU-PROYECTO.supabase.co

# service_role key — SECRETA. Salta RLS. Solo para el script de seed,
# NUNCA en el frontend ni en el navegador.
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY
